{
  "name": "aura-catalog",
  "script": "npm",
  "args": "start",
  "cwd": "/root/catalogo",
  "instances": 1,
  "autorestart": true,
  "max_restarts": 10,
  "min_uptime": "10s",
  "watch": false,
  "exp_backoff_restart_delay": 1000,
  "env": {
    "NODE_ENV": "production"
  },
  "out_file": "/root/catalogo/logs/stdout.log",
  "error_file": "/root/catalogo/logs/stderr.log",
  "log_date_format": "YYYY-MM-DD HH:mm:ss",
  "kill_timeout": 5000
}